# 复制为 .env 后按需填写

# DeepSeek API key（https://platform.deepseek.com 申请）。
# 仅本地自用时生效；设置了 ACCESS_PASSWORD 后不会使用，朋友需在网页上填自己的 key。
DEEPSEEK_API_KEY=

# 给朋友用时必填：打开网页需要输入的密码（用户名随便填）
ACCESS_PASSWORD=

# 以下可选
# MAX_QUEUE=5          # 排队 + 处理中的任务上限，超出时提示“服务器正忙”
# MAX_UPLOAD_MB=4096   # 单个视频上传大小上限
# FILE_TTL_HOURS=24    # 任务完成多久后删除视频和字幕文件（设了密码时默认 24，否则不删）
# HOST=127.0.0.1       # 用 python app.py 启动时的监听地址/端口
# PORT=5001
